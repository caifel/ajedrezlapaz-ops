PROJECT_NAME=ajedrezlapaz
WEB_PATH=../web
API_PATH=../api
OPS_PATH=.
DOTFILES_PATH=${HOME}/Dev/.dotfiles
DEV_WEB_PORT=3000
API_PORT=4000
REDIS_PORT=6379
PROD_WEB_PORT=8080
PROD_API_PORT=8081
PROD_REDIS_PORT=6379
DEV_FRONTEND_URL=http://localhost:3000
PROD_FRONTEND_URL=http://localhost:8080
CSRF_SECRET=replace-with-openssl-rand-hex-32
INTERNAL_API_SECRET=replace-with-openssl-rand-hex-32
REDIS_URL=redis://redis:6379
SQLITE_PATH=/alp/api/data/app.db
# Required in production — Resend API key for email delivery
RESEND_API_KEY=re_xxxxxxxxxxxx
# Optional — sender address (defaults to noreply@support.ajedrezlapaz.com)
EMAIL_FROM=noreply@support.ajedrezlapaz.com
